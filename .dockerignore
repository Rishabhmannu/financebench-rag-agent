# Version control
.git/
.gitignore

# Data (large, not needed in image)
data/raw/
qdrant_data/
pg_data/

# Docker Desktop disk image backups (65 GB sparse files — disastrous if shipped)
Docker-backup-*.raw

# Local-only large artifacts that may exist mid-development
dist/hf-snapshot-*/
publish-assets/

# Runtime artifacts that should never be baked in
logs/
cost_logs/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# Environment (secrets)
.env
.env.local
.env.production

# macOS
.DS_Store

# Testing (not needed in production image)
tests/
.pytest_cache/
htmlcov/
.coverage

# Docs and course materials
_course_materials/
*.md
!README.md

# CI/CD and tooling configs
.github/
.claude/
Makefile
Untitled.txt
